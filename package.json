{
    "name": "lucas-compound",
    "version": "0.1.1",
    "description": "Stores a variation for the compound engineering plugin but simpler",
    "type": "module",
    "private": false,
    "bin": {
        "compound-plugin": "./src/index.ts"
    },
    "publishConfig": {
